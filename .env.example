# Optional. BGG's XML API2 now requires an application token for most requests.
# Without it, the app falls back to the built-in mock dataset.
# Copy this file to .env.local and fill it in.
BGG_API_TOKEN=

# Optional. Supabase accounts + cloud sync (run supabase/schema.sql first).
# Without these the app keeps everything in localStorage.
# Restart the dev server after changing them: NEXT_PUBLIC_ vars are baked in at build/start.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
